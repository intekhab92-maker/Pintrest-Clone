<%- include("./partials/header") %>

<div class="w-full min-h-screen px-8 py-24 text-black ">
 <div class="cards flex flex-wrap gap-6">
  <% posts.forEach(function(post){ %> 
  <div class=" card w-48 bg-zinc-200 transition opacity-100 hover:opacity-70 text-center border rounded-xl">
    <div class="h-56 w-full bg-sky-100 rounded-2xl overflow-hidden">
    <img class="w-full h-full object-cover" src="/images/uploads/<%= post.image %>" alt="image">
  </div>
  <h5 class="text-sm opacity-75">Posted: @<%= post.user.username %></h5>
  <h4 class="mt-2 text-sm px-2">@<%= post.title %></h4>
  <h5><%= post.imageText %></h5>
  </div>
  <% }) %>
 </div>
</div>
<%- include("./partials/footer") %>