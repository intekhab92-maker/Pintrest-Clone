<%- include("./partials/header") %>

<div class="w-full h-full max-w-md mx-auto bg-zinc-100 rounded-xl shadow p-5 mt-4">

    <h2 class="text-3xl font-semibold pb-3">
        Create Post
    </h2>

    <form action="/upload" method="POST" enctype="multipart/form-data" class="space-y-3 max-w-sm mx-auto">
    <input type="text" name="title" placeholder="Title here.." class="w-full border border-gray-200 rounded-xl px-2 py-3 text-sm outline-none transition focus:border-black resize-none">
    <textarea
        name="filecaption"
        placeholder="Write a caption..."
        class="w-full border border-gray-200 rounded-xl p-3 text-sm outline-none transition focus:border-black resize-none"
        rows="2"
    ></textarea>

    <input 
        type="file" 
        name="file"
        class="block w-full text-xs text-gray-500 
               file:mr-3 file:py-2 file:px-4 
               file:rounded-lg file:border-0 file:text-xl file:font-medium
               file:bg-gray-100 file:text-gray-800
               hover:file:bg-gray-200 file:cursor-pointer"
    >
    <button 
        type="submit"
        class="w-full bg-black text-white py-2 px-4 rounded-xl text-xl font-medium transition hover:bg-gray-800"
    >
        Upload
    </button>
</form>

</div>
    </div>


<%- include("./partials/footer") %>