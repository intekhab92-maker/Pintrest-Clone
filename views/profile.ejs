<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>profile</title>
    <link rel="stylesheet" href="/stylesheets/output.css">
    <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
    rel="stylesheet"
    />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/profile.css">
  </head>
  <body>
    <%- include("./partials/header") %>
<main class="main">

    <div class="w-full h-full max-w-md mx-auto transition hover:bg-red-300 rounded-xl  py-3">
        <form  action="/fileupload" method="post" enctype="multipart/form-data" id="uploadform">
    
    <div class="card__image">
        <img class="w-full h-full object-cover rounded-full" src="/images/uploads/<%= user.dp %>" alt="">
        <input hidden type="file" name="dp" id="uploadicon" />
        <label for="uploadicon" class="icon-label-btn" >
            <i class="ri-pencil-fill"></i>
        </label>
    </div>
    <div class="card__info">
            <h2  name="name" class="text-2xl font-bold" ><%= user.fullName %></h2>
            <h3 class="text-xl font-light" name="username">@<%= user.username %></h3>
            <h5 class="text-m font-bold" name="description"><%= user.description %></h5>  
        </div>

        <div class="card__actions">
            <a href="/editprofile" class="card__btn">Edit Profile</a>
        </div>

</form>
    </div>
       
    <br>
    <hr>
</main>
<div class="mt-3 px-5">
    <h2 class="text-3xl font-bold">Your Saved Posts</h2>
</div>
<div class="cards flex flex-wrap gap-10 px-14 mt-3">
    <div class="rounded-xl  bg-red-200">
        <a href="/show" class="grid grid-cols-2 grid-rows-2 h-44 gap-0.5 w-52">

        <% if(user.posts[0]) { %>
            <img
                src="/images/uploads/<%= user.posts[0].image %>"
                class="row-span-2 w-full h-full object-cover">
        <% } %>

        <% if(user.posts[1]) { %>
            <img
                src="/images/uploads/<%= user.posts[1].image %>"
                class="w-full h-full object-cover">
        <% } %>

        <% if(user.posts[2]) { %>
            <img
                src="/images/uploads/<%= user.posts[2].image %>"
                class="w-full h-full object-cover">
        <% } %>

        </a>
        <p class="px-2 inline-block text-xl font-semibold mt-2">Your Uploaded Pins</p>
        <p><a href="/show" class="px-2 text-sm font-medium opacity-60"><%= user.posts.length %>Pins</a></p>
    </div>
</div>
    <script>
document.querySelector("#uploadform input").addEventListener("change", function () {
    document.querySelector("#uploadform").submit();
});
</script>

<%- include("./partials/footer") %>
  </body>
</html>